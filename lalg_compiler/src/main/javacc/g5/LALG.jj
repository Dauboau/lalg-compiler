        }
    )?
}

void argumentos(Set<Integer> followPai) : { 
    Set<Integer> followArgumentos = SintAux.FOLLOW.get("argumentos");
    Set<Integer> sync = SintAux.unir(followArgumentos, followPai); 
}
{
    try {
        <ID> 
    } catch (ParseException e) {
        // Próximo símbolo vem de mais_ident (FIRST = PONTO_VIRGULA)
        Set<Integer> syncVirgula = SintAux.unir(SintAux.FIRST.get("mais_ident"), sync);
        sint.modoPanico(e, syncVirgula);
    }
    ( 
        try {
            <SIMB_PONTO_VIRGULA> 
        } catch (ParseException e) {
