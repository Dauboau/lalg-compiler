options {
    STATIC = false;
}

PARSER_BEGIN(LALG)

package g5;

import java.util.Set;
import java.util.HashSet;
import java.util.Arrays;

public class LALG {
  public Sint sint;
}

PARSER_END(LALG)

/* ========================================================= */
/*                   REGRAS LÉXICAS                       */
/* ========================================================= */

/* ESPAÇOS EM BRANCO E COMENTÁRIOS */
/* Comentários do tipo {...} */
SKIP :
{
    " "
  | "\t"
  | "\n"
  | "\r"
  | <"{" (~["}"])* "}">
}

/* PALAVRAS RESERVADAS */
TOKEN :
{
    < SIMB_PROGRAM: "program" >
  | < SIMB_INICIAR: "begin" >
  | < SIMB_FIM: "end" >
  | < SIMB_CONST: "const" >
  | < SIMB_VAR: "var" >
  | < SIMB_TIPO_REAL: "real" >
  | < SIMB_TIPO_INTEIRO: "integer" >
  | < SIMB_PROCEDIMENTO: "procedure" >
  | < SIMB_SE: "if" >
  | < SIMB_ENTAO: "then" >
  | < SIMB_SENAO: "else" >
  | < SIMB_LEIA: "read" >
  | < SIMB_ESCREVA: "write" >
  | < SIMB_ENQUANTO: "while" >
  | < SIMB_FACA: "do" >
  | < SIMB_PARA: "for" >
  | < SIMB_ATE: "to" >
}

/* OPERADORES E PONTUAÇÃO */
TOKEN :
{
    < SIMB_ATRIBUICAO: ":=" >
  | < SIMB_DOIS_PONTOS: ":" >
  | < SIMB_MENOR_IGUAL: "<=" >
  | < SIMB_DIFERENTE: "<>" >
  | < SIMB_MENOR: "<" >
  | < SIMB_MAIOR_IGUAL: ">=" >
  | < SIMB_MAIOR: ">" >
  | < SIMB_MAIS: "+" >
  | < SIMB_MENOS: "-" >
  | < SIMB_ASTERISCO: "*" >
  | < SIMB_BARRA: "/" >
  | < SIMB_IGUAL: "=" >
  | < SIMB_PONTO_VIRGULA: ";" >
  | < SIMB_PONTO: "." >
  | < SIMB_VIRGULA: "," >
  | < SIMB_ABRE_PARENTESES: "(" >
  | < SIMB_FECHA_PARENTESES: ")" >
}

/* NÚMEROS E IDENTIFICADORES */
TOKEN :
{
    < NUMERO_REAL: (["0"-"9"])+ "." (["0"-"9"])+ >
  | < NUMERO_INTEIRO: (["0"-"9"])+ >
  | < ID: ["a"-"z", "A"-"Z"] (["a"-"z", "A"-"Z", "0"-"9"])* >
}

/* ERROS LÉXICOS */
TOKEN :
{
    < ERRO_IDENTIFICADOR_MAL_FORMADO: (["0"-"9"])+ ["a"-"z", "A"-"Z"] (["a"-"z", "A"-"Z", "0"-"9"])* >
    | < ERRO_NUMERO_REAL_MAL_FORMADO: (["0"-"9"])+ "." (["0"-"9"])* ["a"-"z", "A"-"Z"] (["a"-"z", "A"-"Z", "0"-"9"])* >
    | < ERRO_SIMBOLO_NAO_PERTENCENTE: ~[] >
}

/* ========================================================= */
/*                   REGRAS SINTÁTICAS                       */
/* ========================================================= */

void programa(): { 
    Set<Integer> followPrograma = SintAux.FOLLOW.get("programa"); 
}
{
    try {
        <SIMB_PROGRAM> 
    } catch (ParseException e) {
        // Próximo símbolo é o ID
        if (sint.modoPanico("programa",e, new HashSet<Integer>(Arrays.asList(LALGConstants.ID)), followPrograma)) return;
    }
    
    try {
        <ID> 
    } catch (ParseException e) {
        // Próximo símbolo é o ;
        if (sint.modoPanico("programa",e, new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_PONTO_VIRGULA)), followPrograma)) return;
    }
    
    try {
        <SIMB_PONTO_VIRGULA>
    } catch (ParseException e) {
        // Próximo símbolo é o corpo() -> FIRST do corpo()
        if (sint.modoPanico("programa",e, SintAux.FIRST.get("corpo"), followPrograma)) return;
    }
    
    corpo(followPrograma)
    
    try {
        <SIMB_PONTO>
    } catch (ParseException e) {
        // Próximo é o EOF
        if (sint.modoPanico("programa",e, new java.util.HashSet<Integer>(), followPrograma)) return;
    }
    <EOF>
}

void corpo(Set<Integer> followPai) : { 
    Set<Integer> followCorpo = SintAux.FOLLOW.get("corpo");
    Set<Integer> sync = SintAux.unir(followCorpo, followPai); 
}
{
    dc(sync)
    
    try {
        <SIMB_INICIAR> 
    } catch (ParseException e) {
        // Próximo símbolo pode vir de comandos (FIRST), mas como pode ser λ (vazio), incluímos também o SIMB_FIM
        Set<Integer> filhos = new HashSet<Integer>(SintAux.FIRST.get("comandos"));
            filhos.add(LALGConstants.SIMB_FIM);
            if (sint.modoPanico("corpo", e, filhos, sync)) return;
    }
    
    comandos(sync) 
    
    try {
        <SIMB_FIM>
    } catch (ParseException e) {
        // Como é o último elemento, a sincronização recorre apenas ao sync (FOLLOW da regra + followPai)
        if (sint.modoPanico("corpo", e, new java.util.HashSet<Integer>(), sync)) return;
    }
}

void dc(Set<Integer> followPai) : { 
    Set<Integer> followDc = SintAux.FOLLOW.get("dc");
    Set<Integer> sync = SintAux.unir(followDc, followPai); 
}
{
    dc_c(sync) dc_v(sync) dc_p(sync)
}

