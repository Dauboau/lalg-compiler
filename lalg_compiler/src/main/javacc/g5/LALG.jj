options {
    STATIC = false;
}

PARSER_BEGIN(LALG)

package g5;

import java.util.Set;
import java.util.HashSet;
import java.util.Arrays;

public class LALG {
  public Sint sint;
}

PARSER_END(LALG)

/* ========================================================= */
/*                   REGRAS LÉXICAS                       */
/* ========================================================= */

/* ESPAÇOS EM BRANCO E COMENTÁRIOS */
/* Comentários do tipo {...} */
SKIP :
{
    " "
  | "\t"
  | "\n"
  | "\r"
  | <"{" (~["}"])* "}">
}

/* PALAVRAS RESERVADAS */
TOKEN :
{
    < SIMB_PROGRAM: "program" >
  | < SIMB_INICIAR: "begin" >
  | < SIMB_FIM: "end" >
  | < SIMB_CONST: "const" >
  | < SIMB_VAR: "var" >
  | < SIMB_TIPO_REAL: "real" >
  | < SIMB_TIPO_INTEIRO: "integer" >
  | < SIMB_PROCEDIMENTO: "procedure" >
  | < SIMB_SE: "if" >
  | < SIMB_ENTAO: "then" >
  | < SIMB_SENAO: "else" >
  | < SIMB_LEIA: "read" >
  | < SIMB_ESCREVA: "write" >
  | < SIMB_ENQUANTO: "while" >
  | < SIMB_FACA: "do" >
  | < SIMB_PARA: "for" >
  | < SIMB_ATE: "to" >
}

/* OPERADORES E PONTUAÇÃO */
TOKEN :
{
    < SIMB_ATRIBUICAO: ":=" >
  | < SIMB_DOIS_PONTOS: ":" >
  | < SIMB_MENOR_IGUAL: "<=" >
  | < SIMB_DIFERENTE: "<>" >
  | < SIMB_MENOR: "<" >
  | < SIMB_MAIOR_IGUAL: ">=" >
  | < SIMB_MAIOR: ">" >
  | < SIMB_MAIS: "+" >
  | < SIMB_MENOS: "-" >
  | < SIMB_ASTERISCO: "*" >
  | < SIMB_BARRA: "/" >
  | < SIMB_IGUAL: "=" >
  | < SIMB_PONTO_VIRGULA: ";" >
  | < SIMB_PONTO: "." >
  | < SIMB_VIRGULA: "," >
  | < SIMB_ABRE_PARENTESES: "(" >
  | < SIMB_FECHA_PARENTESES: ")" >
}

/* NÚMEROS E IDENTIFICADORES */
TOKEN :
{
    < NUMERO_REAL: (["0"-"9"])+ "." (["0"-"9"])+ >
  | < NUMERO_INTEIRO: (["0"-"9"])+ >
  | < ID: ["a"-"z", "A"-"Z"] (["a"-"z", "A"-"Z", "0"-"9"])* >
}

/* ERROS LÉXICOS */
TOKEN :
{
    < ERRO_IDENTIFICADOR_MAL_FORMADO: (["0"-"9"])+ ["a"-"z", "A"-"Z"] (["a"-"z", "A"-"Z", "0"-"9"])* >
    | < ERRO_NUMERO_REAL_MAL_FORMADO: (["0"-"9"])+ "." (["0"-"9"])* ["a"-"z", "A"-"Z"] (["a"-"z", "A"-"Z", "0"-"9"])* >
    | < ERRO_SIMBOLO_NAO_PERTENCENTE: ~[] >
}

/* ========================================================= */
/*                   REGRAS SINTÁTICAS                       */
/* ========================================================= */

void programa(): { 
    Set<Integer> followPrograma = SintAux.FOLLOW.get("programa"); 
}
{
    try {
        <SIMB_PROGRAM> 
    } catch (ParseException e) {
        // Próximo símbolo é o ID
        sint.modoPanico(e, SintAux.unir(new HashSet<Integer>(Arrays.asList(LALGConstants.ID)), followPrograma));
    }
    
    try {
        <ID> 
    } catch (ParseException e) {
        // Próximo símbolo é o ;
        sint.modoPanico(e, SintAux.unir(new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_PONTO_VIRGULA)), followPrograma));
    }
    
    try {
        <SIMB_PONTO_VIRGULA>
    } catch (ParseException e) {
        // Próximo símbolo é o corpo() -> FIRST do corpo()
        sint.modoPanico(e, SintAux.unir(SintAux.FIRST.get("corpo"), followPrograma));
    }
    
    corpo(followPrograma)
    
    try {
        <SIMB_PONTO>
    } catch (ParseException e) {
        // Próximo é o EOF
        sint.modoPanico(e, followPrograma);
    }
    <EOF>
}

void corpo(Set<Integer> followPai) : { 
    Set<Integer> followCorpo = SintAux.FOLLOW.get("corpo");
    Set<Integer> sync = SintAux.unir(followCorpo, followPai); 
}
{
    dc(sync)
    
    try {
        <SIMB_INICIAR> 
    } catch (ParseException e) {
        // Próximo símbolo pode vir de comandos (FIRST), mas como pode ser λ (vazio), incluímos também o SIMB_FIM
        Set<Integer> syncIniciar = SintAux.unir(SintAux.FIRST.get("comandos"), sync);
        syncIniciar.add(LALGConstants.SIMB_FIM);
        sint.modoPanico(e, syncIniciar);
    }
    
    comandos(sync) 
    
    try {
        <SIMB_FIM>
    } catch (ParseException e) {
        // Como é o último elemento, a sincronização recorre apenas ao sync (FOLLOW da regra + followPai)
        sint.modoPanico(e, sync);
    }
}

void dc(Set<Integer> followPai) : { 
    Set<Integer> followDc = SintAux.FOLLOW.get("dc");
    Set<Integer> sync = SintAux.unir(followDc, followPai); 
}
{
    dc_c(sync) dc_v(sync) dc_p(sync)
}

void dc_c(Set<Integer> followPai) : { 
    Set<Integer> followDcC = SintAux.FOLLOW.get("dc_c");
    Set<Integer> sync = SintAux.unir(followDcC, followPai); 
}
{
    ( 
        try {
            <SIMB_CONST> 
        } catch (ParseException e) {
            // Próximo símbolo é o ID
            sint.modoPanico(e, SintAux.unir(new HashSet<Integer>(Arrays.asList(LALGConstants.ID)), sync));
        }
        try {
            <ID> 
        } catch (ParseException e) {
            // Próximo símbolo é o =
            sint.modoPanico(e, SintAux.unir(new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_IGUAL)), sync));
        }
        try {
            <SIMB_IGUAL> 
        } catch (ParseException e) {
            // Próximo símbolo vem da regra numero -> FIRST de numero()
            sint.modoPanico(e, SintAux.unir(SintAux.FIRST.get("numero"), sync));
        }
        numero(sync) 
        try {
            <SIMB_PONTO_VIRGULA>
        } catch (ParseException e) {
            // Próximo símbolo do loop pode ser CONST (FIRST de dc_c) ou fim do loop (recorre ao sync)
            Set<Integer> syncPV = SintAux.unir(SintAux.FIRST.get("dc_c"), sync);
            sint.modoPanico(e, syncPV);
        }
    )*
}

void dc_v(Set<Integer> followPai) : { 
    Set<Integer> followDcV = SintAux.FOLLOW.get("dc_v");
    Set<Integer> sync = SintAux.unir(followDcV, followPai); 
