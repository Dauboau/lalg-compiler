            if (sint.modoPanico("dc_c", e, new HashSet<Integer>(Arrays.asList(LALGConstants.ID)), sync)) return;
        }
        try {
            <ID> 
        } catch (ParseException e) {
            // Próximo símbolo é o =
            if (sint.modoPanico("dc_c", e, new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_IGUAL)), sync)) return;
        }
        try {
            <SIMB_IGUAL> 
        } catch (ParseException e) {
            // Próximo símbolo vem da regra numero -> FIRST de numero()
            if (sint.modoPanico("dc_c", e, SintAux.FIRST.get("numero"), sync)) return;
        }
        numero(sync) 
        try {
            <SIMB_PONTO_VIRGULA>
        } catch (ParseException e) {
            // Próximo símbolo do loop pode ser CONST (FIRST de dc_c, que inclui λ) ou fim do loop (recorre ao sync)
            if (sint.modoPanico("dc_c", e, SintAux.FIRST.get("dc_c"), sync)) return;
        }
    )*
}

