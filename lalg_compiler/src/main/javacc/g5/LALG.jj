void fator(Set<Integer> followPai) : { 
    Set<Integer> followFator = SintAux.FOLLOW.get("fator");
    Set<Integer> sync = SintAux.unir(followFator, followPai); 
}
{
    try {
        <ID>
    } catch (ParseException e) {
        // Usa o sync nativo do follow
        sint.modoPanico(e, sync);
    } 
    | numero(sync) 
    | try { <SIMB_ABRE_PARENTESES> } catch (ParseException e) { 
        // Próximo símbolo vem de expressao (FIRST)
        sint.modoPanico(e, SintAux.unir(SintAux.FIRST.get("expressao"), sync)); 
      } 
      expressao(sync) 
      try { <SIMB_FECHA_PARENTESES> } catch (ParseException e) { 
        // Como é o último elemento, a sincronização recorre apenas ao sync
        sint.modoPanico(e, sync); 
      }
}

