void cmd(Set<Integer> followPai) : { 
    Set<Integer> followCmd = SintAux.FOLLOW.get("cmd");
    Set<Integer> sync = SintAux.unir(followCmd, followPai); 
}
{
    (
        try { <SIMB_LEIA> } catch (ParseException e) { 
            // Próximo símbolo é o abre_parenteses
            if (sint.modoPanico("cmd", e, new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_ABRE_PARENTESES)), sync)) return; 
        }
        try { <SIMB_ABRE_PARENTESES> } catch (ParseException e) { 
            // Próximo símbolo vem de variaveis (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("variaveis"), sync)) return; 
        }
        variaveis(sync) 
        try { <SIMB_FECHA_PARENTESES> } catch (ParseException e) { 
            // Como é o último elemento, a sincronização recorre apenas ao sync
            if (sint.modoPanico("cmd", e, new java.util.HashSet<Integer>(), sync)) return; 
        }
        
      | try { <SIMB_ESCREVA> } catch (ParseException e) { 
            // Próximo símbolo é o abre_parenteses
            if (sint.modoPanico("cmd", e, new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_ABRE_PARENTESES)), sync)) return; 
        }
        try { <SIMB_ABRE_PARENTESES> } catch (ParseException e) { 
            // Próximo símbolo vem de variaveis (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("variaveis"), sync)) return; 
        }
        variaveis(sync) 
        try { <SIMB_FECHA_PARENTESES> } catch (ParseException e) { 
            // Como é o último elemento, a sincronização recorre apenas ao sync
            if (sint.modoPanico("cmd", e, new java.util.HashSet<Integer>(), sync)) return; 
        }
        
      | try { <SIMB_ENQUANTO> } catch (ParseException e) { 
            // Próximo símbolo é o abre_parenteses
            if (sint.modoPanico("cmd", e, new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_ABRE_PARENTESES)), sync)) return; 
        }
        try { <SIMB_ABRE_PARENTESES> } catch (ParseException e) { 
            // Próximo símbolo vem de condicao (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("condicao"), sync)) return; 
        }
        condicao(sync) 
        try { <SIMB_FECHA_PARENTESES> } catch (ParseException e) { 
            // Próximo símbolo é FACA
            if (sint.modoPanico("cmd", e, new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_FACA)), sync)) return; 
        }
        try { <SIMB_FACA> } catch (ParseException e) { 
            // Próximo símbolo vem de cmd (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("cmd"), sync)) return; 
        }
        cmd(sync)
        
      | try { <SIMB_SE> } catch (ParseException e) { 
            // Próximo símbolo vem de condicao (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("condicao"), sync)) return; 
        }
        condicao(sync) 
        try { <SIMB_ENTAO> } catch (ParseException e) { 
            // Próximo símbolo vem de cmd (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("cmd"), sync)) return; 
        }
        cmd(sync) pfalsa(sync)
        
      | try { <SIMB_PARA> } catch (ParseException e) { 
            // Próximo símbolo é ID
            if (sint.modoPanico("cmd", e, new HashSet<Integer>(Arrays.asList(LALGConstants.ID)), sync)) return; 
        }
        try { <ID> } catch (ParseException e) { 
            // Próximo símbolo é ATRIBUICAO
            if (sint.modoPanico("cmd", e, new HashSet<Integer>(Arrays.asList(LALGConstants.SIMB_ATRIBUICAO)), sync)) return; 
        }
        try { <SIMB_ATRIBUICAO> } catch (ParseException e) { 
            // Próximo símbolo vem de expressao (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("expressao"), sync)) return; 
        }
        expressao(sync) 
        try { <SIMB_ATE> } catch (ParseException e) { 
            // Próximo símbolo vem de expressao (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("expressao"), sync)) return; 
        }
        expressao(sync) 
        try { <SIMB_FACA> } catch (ParseException e) { 
            // Próximo símbolo vem de cmd (FIRST)
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("cmd"), sync)) return; 
        }
        cmd(sync)
        
      | try { <ID> } catch (ParseException e) { 
            // Próximo símbolo pode vir de cmd_aux (FIRST), que inclui λ
            if (sint.modoPanico("cmd", e, SintAux.FIRST.get("cmd_aux"), sync)) return; 
        }
        cmd_aux(sync)
        
      | try { <SIMB_INICIAR> } catch (ParseException e) { 
            // Próximo símbolo vem de comandos (FIRST, que inclui λ) ou SIMB_FIM
            Set<Integer> filhos = new HashSet<Integer>(SintAux.FIRST.get("comandos"));
            filhos.add(LALGConstants.SIMB_FIM);
            if (sint.modoPanico("cmd", e, filhos, sync)) return; 
        }
        comandos(sync) 
        try { <SIMB_FIM> } catch (ParseException e) { 
            // Como é o último elemento, a sincronização recorre apenas ao sync
            if (sint.modoPanico("cmd", e, new java.util.HashSet<Integer>(), sync)) return; 
        }
    )
}

void cmd_aux(Set<Integer> followPai) : { 
    Set<Integer> followCmdAux = SintAux.FOLLOW.get("cmd_aux");
    Set<Integer> sync = SintAux.unir(followCmdAux, followPai); 
}
{
    ( try { <SIMB_ATRIBUICAO> } catch (ParseException e) { 
        // Próximo símbolo vem de expressao (FIRST)
        if (sint.modoPanico("cmd_aux", e, SintAux.FIRST.get("expressao"), sync)) return; 
    } expressao(sync) )
    | lista_arg(sync)
}

